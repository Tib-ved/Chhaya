STORE=memory
GCP_PROJECT=chhaya-pilot
INTERNAL_SECRET=dev-secret
LOCAL_TZ=Asia/Kolkata
CALL_START_HOUR=8
CALL_END_HOUR=20
SEED_ON_START=true
# Numbers in international format with a leading plus sign, comma-separated.
TEAM_PHONES=
LIVE_MODEL=gemini-3.8-live
LIVE_LOCATION=us-central1
# Tuning the voice agent (see "Tuning the voice agent" in the README). Each call stores the
# values it ran with as live_settings, so test calls can be compared.
# How long a pause ends the person's turn, in milliseconds. Elderly speakers pause.
LIVE_SILENCE_MS=700
# The prebuilt voice. Kore is a woman's voice, heard on a real call with this model. Empty
# leaves the model's default voice. A name the model refuses stops calls from opening: try a
# new name with scripts/live_smoke.py before it is deployed.
LIVE_VOICE=Kore
# woman or man: the gender the agent uses for itself. Must match the voice.
LIVE_SPEAKS_AS=woman
# default, low or high: how readily a sound counts as the start of speech.
LIVE_START_SENSITIVITY=low
# default, low or high: how readily a pause counts as the end of speech.
LIVE_END_SENSITIVITY=default
# Milliseconds of speech needed before it counts as started. 0 leaves the service's default.
LIVE_PREFIX_PADDING_MS=200
# false: the person's speech does not cut the agent off.
LIVE_INTERRUPTIONS=true
# When nobody has been speaking for this many seconds in the middle of a call, the agent is
# prompted to ask whether it can be heard and to ask its last question again. 0 = off.
LIVE_QUIET_SECONDS=5
# The most such prompts in a row without the person being heard; then the line is left alone
# until they speak.
LIVE_QUIET_LIMIT=2
# Once every question is answered, how many seconds of silence before the agent is asked for
# its goodbye, and how many more before a call it has still not ended is ended. At least 1.
LIVE_CLOSING_SILENCE_SECONDS=5
# true: once the agent has asked a question, nothing more it says is passed on to the person
# until they are heard (or the agent has been prompted or refused, or an emergency is flagged).
# It stops the agent asking the same thing twice over the answer. false passes everything on.
LIVE_MUTE_REPEATS=true
# The longest, in seconds, the person's audio is withheld while the first greeting is spoken.
# What they say meanwhile is discarded, not kept for later. 0 = off.
LIVE_GREETING_GUARD_SECONDS=6

# Voice agent
MAX_CALL_SECONDS=300

# Phone calls through Twilio. Leave all empty to use only the browser call;
# if any of the three TWILIO_* values is set, all three must be.
# Change INTERNAL_SECRET to a long random value before filling in any of these:
# the server refuses to start with the default secret once PUBLIC_HOST or a TWILIO_* value is set.
# PUBLIC_HOST is a bare host name, with no https://.
PUBLIC_HOST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Numbers in international format with a leading plus sign, comma-separated.
DIAL_ALLOWLIST=

# Sign-in with Google. Setting ALLOWED_EMAILS (comma-separated addresses) turns sign-in on:
# every page and endpoint then needs a signed-in account from that list, or the internal secret.
# With it set, GOOGLE_CLIENT_ID (the client id of an OAuth "Web application" client; not a
# secret) is required, INTERNAL_SECRET must be a long random value, and SESSION_SECRET must be
# another random value of at least 32 characters (it signs the session cookie), or the server
# refuses to start. Leave ALLOWED_EMAILS empty for local development without sign-in.
# On Cloud Run the server refuses to start without ALLOWED_EMAILS unless ALLOW_OPEN_ACCESS=true.
GOOGLE_CLIENT_ID=
ALLOWED_EMAILS=
OPERATIONS_ADMIN_EMAILS=
OPERATIONS_CREW_ACCOUNTS={}
SESSION_SECRET=
SESSION_HOURS=12
ALLOW_OPEN_ACCESS=false

# The demo that visitors see. The pinned round is rebuilt by POST /internal/demo/rebuild
# (and at start-up when SEED_ON_START=true with STORE=memory).
DEMO_DISTRICT_ID=churu
# How long, in seconds, the part of the demo round that every visitor sees alike is kept
# between reads of the store. 0 reads the store on every request, which suits development.
# Set 2 for a deployment that is open to the public: without it every anonymous request
# re-reads the whole round. A visitor's own call is never kept, so it shows at once.
VIEW_CACHE_SECONDS=0
# What an open call may cost. A call whose agent never started is not counted.
VISITOR_CALLS_PER_HOUR=3
ADDRESS_CALLS_PER_HOUR=6
VISITOR_CALLS_AT_ONCE=3
VISITOR_CALLS_PER_DAY=150
# Every call asked for in a day, whether or not its agent was started. Over it, visitors are
# refused as they are over VISITOR_CALLS_PER_DAY.
VISITOR_TICKETS_PER_DAY=1500
# How often a running call's transcript is stored, in seconds. 0 stores it only at the end.
TRANSCRIPT_SAVE_SECONDS=1.5
# Replace the voice agent with a script, for building screens with no microphone and no bill.
# The server refuses to start with this on Cloud Run.
FAKE_LIVE=false
FAKE_LIVE_STEP_SECONDS=1.2

# The built web app is served from app/static/web (see scripts/stage_web.py). Set WEB_DIR to
# serve it from somewhere else.
WEB_DIR=

# Case notes and the report summary. Empty means neither is written.
TEXT_MODEL=
TEXT_LOCATION=global
# How hard the text model thinks. With the model's default (empty) one paragraph takes 7 to 10
# seconds and is cut off by the 8-second limit; "low" takes about 2.
TEXT_THINKING=low

# The call queue. Empty TASKS_QUEUE means calls are planned but nothing dials them.
# TASKS_TARGET is this service's own https address. TASKS_SERVICE_ACCOUNT is needed only while
# Cloud Run refuses unauthenticated requests.
TASKS_QUEUE=
TASKS_LOCATION=asia-south1
TASKS_TARGET=
TASKS_SERVICE_ACCOUNT=

# The forecast that opens rounds. Thresholds are degrees Celsius.
# Leave the key empty to read the `weather-api-key` secret in GCP_PROJECT from Secret Manager
# (needs `gcloud auth application-default login` as an account with Secret Accessor).
WEATHER_API_KEY=
HEAT_ORANGE_C=45
HEAT_RED_C=47
COLD_ORANGE_C=4
COLD_RED_C=2
# Start calling as soon as the forecast opens a round. On a deployment this rings real phones.
INGEST_AUTO_DISPATCH=false

ADDRESS_FAILED_STARTS_PER_HOUR=6
LIVE_CONNECT_SECONDS=15
WORKER_THREADS=32
